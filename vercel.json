{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(assets|issues|audio)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|mp3|woff2|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/watering-grass-in-a-thunderstorm", "destination": "/watering-grass-in-a-thunderstorm.html" },
    { "source": "/watering-grass", "destination": "/watering-grass-in-a-thunderstorm.html" },
    { "source": "/issue-01", "destination": "/issue-01.html" },
    { "source": "/the-meat-grinder", "destination": "/the-meat-grinder.html" },
    { "source": "/issue-02", "destination": "/issue-02.html" },
    { "source": "/war-on-drugs", "destination": "/war-on-drugs.html" },
    { "source": "/the-war-no-one-was-supposed-to-win", "destination": "/the-war-no-one-was-supposed-to-win.html" },
    { "source": "/issue-03", "destination": "/issue-03.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
