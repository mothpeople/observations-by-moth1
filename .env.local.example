# Observations by Moth1 — Local Publishing API Secrets
# (This file is safe to keep as a reference; your actual secrets belong in .env.local)

# ==============================================================================
# 1. PINTEREST MARKETING API (v5)
# ==============================================================================
# Paste your Pinterest Access Token (starts with 'pina_...')
PINTEREST_ACCESS_TOKEN="your_pinterest_access_token_here"

# Optional: Default Pinterest Board ID to post pins to.
# If left blank, our script will list all your boards and let you select one.
PINTEREST_BOARD_ID=""

# ==============================================================================
# 2. YOUTUBE DATA API (v3)
# ==============================================================================
# Path to the downloaded OAuth2 Client Secret JSON file from Google Cloud Console
GOOGLE_CLIENT_SECRETS_FILE=".secrets/google_client_secrets.json"
